---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
const mapboxToken = import.meta.env.PUBLIC_MAPBOX_TOKEN;
---

<Layout>
  <!-- Yderste boks: lilla baggrund, indhold stablet lodret, skubbet ned under headeren (pt-[8vh]) -->
  <div class="bg-[#ccbddd] flex flex-col pt-[8vh]">

    <!-- Begivenhedssektionen med lilla baggrund -->
    <div class="px-[5%] py-7">

<!-- whitespace-nowrap = lad overskriften aldrig brække til to linjer. font-style:italic = kursiv -->
<h1 class="text-white font-bold mb-3 whitespace-nowrap" style="font-style: italic; font-size: clamp(1.5rem, 5vw, 3rem);">
  Kommende begivenheder:
</h1>

      <div class="visualisering-kasse">
        <p class="text-[#353635] font-bold mb-1" style="font-size: clamp(1rem, 3vw, 1.75rem)">Find din næste begivenhed her:</p>
        <!-- TOM med vilje: scriptet fylder denne boks med begivenheds-kort (genbruger sut-container) -->
        <div id="sut-container" class="sut-container"></div>
      </div>

    </div>

    <!-- Kortsektion (hvid baggrund) -->
    <div class="px-[5%] bg-[#ffffff] pb-10 pt-5">
      <h2 class="text-[#353635] font-bold mb-1" style="font-size: clamp(1rem, 3vw, 1.75rem) font-family: 'Agrandir-GrandHeavy', sans-serif;">
        Find begivenheder på kortet:
      </h2>
      <!-- Mapbox tegner kortet ind i netop denne div (scriptet finder den via id="kort").
           overflow:hidden klipper kortet pænt af inden for de afrundede hjørner. -->
      <div id="kort" style="width:100%; height:500px; border-radius:1rem; overflow:hidden;"></div>
    </div>

  </div>

 <!-- Dette er en api nøgle et et kort med datapunkter som er lavet af AI -->
  <!-- Mapbox' eget stylesheet (kræves for at kortet og markørerne ser rigtige ud) -->
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.css" rel="stylesheet" />

  <script is:inline>

    // ── Begivenhedsdata med koordinater ──
    const begivenheder = [
      { navn: "Cafetur, 19 maj.",       alder: "13:00 - 15:00, 2026", tekst: "Adresse: Vesterbrogade 142, 1620 København V", koordinater: [12.5483, 55.6731] },
      { navn: "Babysvømning, 22 juni.", alder: "10:00 - 11:30, 2026", tekst: "Adresse: Spanien 1, 8000 Aarhus C",            koordinater: [10.2134, 56.1496] },
      { navn: "Kreativ workshop, 3 juli.", alder: "14:00 - 16:00, 2026", tekst: "Adresse: Kongensgade 111, 6700 Esbjerg",    koordinater: [8.4524, 55.4762] },
      { navn: "Sommerpicnic, 18 juli.", alder: "12:00 - 15:00, 2026", tekst: "Adresse: Mølleplads 4, 9000 Aalborg",          koordinater: [9.9217, 57.0488] },
      { navn: "Mødregruppe, 7 august.", alder: "15:00 - 17:00, 2026", tekst: "Adresse: Jernbanegade 23, 5000 Odense C",      koordinater: [10.3818, 55.3959] },
      { navn: "Brunch og baby, 23 august.", alder: "10:30 - 12:30, 2026", tekst: "Adresse: Nygade 6, 7400 Herning",          koordinater: [9.0218, 56.1357] }
    ];

    // ── Vis begivenhedskort i listen ──
    const container = document.getElementById('sut-container');
    container.style.position = 'relative';
    container.style.height = '400px';
    container.style.overflowY = 'auto';
    container.style.display = 'flex';
    container.style.flexDirection = 'column';
    container.style.gap = '1rem';
    container.style.padding = '0.5rem 0';

    begivenheder.forEach(begivenhed => {
      const begivenhedsKort = document.createElement('div');
      begivenhedsKort.className = 'kommentar-kort';
      begivenhedsKort.innerHTML = `
        <p class="kommentar-navn">${begivenhed.navn} · ${begivenhed.alder}</p>
        <p class="kommentar-tekst">${begivenhed.tekst}</p>
        <button class="knap se-mere-knap">Se mere</button>
      `;
      container.appendChild(begivenhedsKort);
    });

    // ── Indlæs Mapbox og opret kort ──
    // Mapbox GL JS hentes fra CDN og køres når siden er loadet
    const mapboxScript = document.createElement('script');
    mapboxScript.src = 'https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.js';
    mapboxScript.onload = () => {

      // Din Mapbox adgangsnøgle
      mapboxgl.accessToken = 'pk.eyJ1IjoiNTcxNTUiLCJhIjoiY21xYXZxZDN3MDh4NzJ0cXNydjVwYzZuMSJ9.Wot7uHJ0c4e9y5o1n-sofA';

      // Opret kortet centreret over Danmark
      const kortet = new mapboxgl.Map({
        container: 'kort',
        style: 'mapbox://styles/mapbox/standard',
        center: [10.5, 56.0],
        zoom: 6
      });

      // Tilføj en markør for hver begivenhed
      begivenheder.forEach(begivenhed => {
        const infoboks = new mapboxgl.Popup({ offset: 25 })
          .setHTML(`
            <strong style="color:#78ba53">${begivenhed.navn}</strong><br>
            ${begivenhed.alder}<br>
            ${begivenhed.tekst}
          `);

        new mapboxgl.Marker({ color: '#78ba53' })
          .setLngLat(begivenhed.koordinater)
          .setPopup(infoboks)
          .addTo(kortet);
      });
    };

    document.head.appendChild(mapboxScript);

  </script>
</Layout>