<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@700&display=swap" rel="stylesheet" />
    <slot name="head" />
    <title>Headspace</title>
  </head>
  <body>
    <header class="side-header">
      <a href="/" style="text-decoration: none;">
        <img src="/Billeder/Mortilmorlogo.svg" alt="Menu" style="height:3.2rem; cursor:pointer;" />
      </a>
      <img id="burger-knap" src="/Billeder/Burger.svg" alt="Menu" style="height:1.5rem; cursor:pointer;" />
    </header>

    <nav id="menu-overlay" class="menu-overlay">
      <a href="/" class="menu-link">Forside</a>
      <a href="/datavisualisering" class="menu-link">Datavisualisering</a>
      <a href="/faelleskab" class="menu-link">Fælleskaber</a>
    </nav>

    <slot />

    <script>
      const burger = document.getElementById("burger-knap");
      const menu = document.getElementById("menu-overlay");

      burger?.addEventListener("click", () => {
        menu?.classList.toggle("menu-overlay-aaben");
      });
    </script>
  </body>
</html>