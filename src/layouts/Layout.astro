<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@700&display=swap" rel="stylesheet" />
    <slot name="head" />
     <title>MorTilMor</title>
    <link rel="icon" type="image/svg+xml" href="/Billeder/Mortilmorlogo.svg" />
  </head>
  <body>
    <!--  Fixed header med logo and burger menu -->
    <header class="side-header"> 
      <a href="/" style="text-decoration: none;"> 
        <img src="/Billeder/Mortilmorlogo.svg" alt="Menu" style="height:3.2rem; cursor:pointer;" />
      </a>

      <!-- Burgerknap der åbner menuen -->
      <img id="burger-knap" src="/Billeder/Burger.svg" alt="TilForsiden" style="height:1.5rem; cursor:pointer;" />
    </header>
    <nav id="menu-overlay" class="menu-overlay">
      <a href="/" class="menu-link">Forside</a>
      <a href="/datavisualisering" class="menu-link">Datavisualisering</a>
      <a href="/faelleskab" class="menu-link">Fælleskaber</a>
    </nav>

    <slot />

    <script>
      const burgerKnap = document.getElementById("burger-knap");
      const menuOverlay = document.getElementById("menu-overlay");

      
      burgerKnap?.addEventListener("click", () => { //Arrow function
        menuOverlay?.classList.toggle("menu-overlay-aaben");
      });
    </script>
  </body>
</html>